# =============================================================
# VidAI Studio - Environment Configuration
# =============================================================

# Video Upload & Captions Pipeline (Phase 1 - 100% Offline)
UPLOAD_DIR=./data/videos
MAX_UPLOAD_MB=500
WHISPER_MODEL=base
WHISPER_LANGUAGE=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Pluggable Storage (Local disk storage default)
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Pluggable Database (SQLite default)
DATABASE_URL=sqlite:///./video_editor.db

# Pluggable Task Queue
QUEUE_BACKEND=asyncio
